local isOpen = false
local isDragging = false
local dragStart = nil
local startX = nil

local function OpenPhone()
    isOpen = true
    TweenService:Create(PhoneFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 5, 0.5, -110)
    }):Play()
    TweenService:Create(SwipeTab, TweenInfo.new(0.3), {
        BackgroundTransparency = 1
    }):Play()
end

local function ClosePhone()
    isOpen = false
    TweenService:Create(PhoneFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(0, -210, 0.5, -110)
    }):Play()
    TweenService:Create(SwipeTab, TweenInfo.new(0.3), {
        BackgroundTransparency = 0.3
    }):Play()
end

CloseButton.MouseButton1Click:Connect(ClosePhone)

SwipeTab.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startX = PhoneFrame.Position.X.Offset
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position.X - dragStart.X
        local newX = startX + delta
        newX = math.clamp(newX, -210, 5)
        PhoneFrame.Position = UDim2.new(0, newX, 0.5, -110)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isDragging then
            isDragging = false
            local currentX = PhoneFrame.Position.X.Offset
            if currentX > -105 then
                OpenPhone()
            else
                ClosePhone()
            end
        end
    end
end)

SwipeTab.MouseButton1Click:Connect(function()
